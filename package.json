{
  "name": "tiktok-production-studio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "studio": "remotion studio --no-open",
    "studio:legacy": "remotion studio src/index.jsx --port=3002 --no-open",
    "render": "remotion render ATCFishOilV2 outputs/atc-fish-oil-social-v2.mp4",
    "render:v3": "node scripts/render-v3.mjs",
    "audio:v3": "node scripts/sound-v3.mjs --mix-existing",
    "render:legacy": "remotion render src/index.jsx ATCFishOil outputs/atc-fish-oil-social-legacy.mp4",
    "models:download": "node scripts/download-remotion-models.mjs",
    "sfx:download": "node scripts/download-remotion-sfx.mjs",
    "render:ashwagandha": "node scripts/render-ashwagandha-clean.mjs",
    "assets:restore": "node scripts/restore-assets.mjs",
    "assets:verify": "node scripts/verify-assets.mjs",
    "reproduce:ashwagandha": "node scripts/render-ashwagandha-clean.mjs --skip-audio",
    "reproduce:fish-oil": "node scripts/render-v3.mjs --skip-audio",
    "audio:ashwagandha": "node scripts/render-ashwagandha-clean.mjs --audio-only",
    "sfx:original": "node scripts/ashwagandha-original-sfx.mjs",
    "check:project": "node scripts/doctor.mjs",
    "setup:project": "pnpm run assets:restore && pnpm run check:project"
  },

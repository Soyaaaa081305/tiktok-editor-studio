  "captions": [
    {
      "startSeconds": 1.64,
      "endSeconds": 4.6,
      "text": "Bakit nga ba hindi reliable ang somatotypes?"
    },
    {
      "startSeconds": 4.84,
      "endSeconds": 8,
      "text": "Mainly ectomorph, endomorph, and mesomorph?"
    },
    {
      "startSeconds": 13.56,
      "endSeconds": 14.56,
      "text": "Here's the reality."
    },
    {
      "startSeconds": 16.9,
      "endSeconds": 20,
      "text": "Somatotypes aren't rooted in modern exercise science."
    },
    {
      "startSeconds": 20.26,
      "endSeconds": 22.08,
      "text": "Inimbento 'to noong 1940s"
    },
    {
      "startSeconds": 22.12,
      "endSeconds": 25.38,
      "text": "ng isang psychologist named William Herbert Sheldon."
    },
    {
      "startSeconds": 25.72,
      "endSeconds": 28.5,
      "text": "And get this, hindi man lang fitness o metabolism"
    },
    {
      "startSeconds": 28.5,
      "endSeconds": 29.56,
      "text": "ang pinag-aralan niya."
    },
    {
      "startSeconds": 29.82,
      "endSeconds": 33.3,
      "text": "He used constitutional psychology para subukang patunayan"
    },
    {
      "startSeconds": 33.54,
      "endSeconds": 36.32,
      "text": "na your body shape dictates your personality"
    },
    {
      "startSeconds": 36.78,
      "endSeconds": 38.86,
      "text": "intelligence, and tendencies sa delinquency."
    },
    {
      "startSeconds": 43.46,
      "endSeconds": 46.48,
      "text": "Modern exercise physiology has debunked this over and over."
    },
    {
      "startSeconds": 46.58,
      "endSeconds": 49.58,
      "text": "Ang katawan natin is polygenic at infinitely"
    },
    {
      "startSeconds": 49.58,
      "endSeconds": 53,
      "text": "more complex kaysa sa three arbitrary boxes."
    },
    {
      "startSeconds": 53.24,
      "endSeconds": 55.58,
      "text": "Somatotype isn't a genetic blueprint."
    },
    {
      "startSeconds": 55.66,
      "endSeconds": 58.56,
      "text": "It's a snapshot of your current energy balance,"
    },
    {
      "startSeconds": 58.66,
      "endSeconds": 60,
      "text": "muscle mass, and lifestyle."
    },
    {
      "startSeconds": 72.7,
      "endSeconds": 76.18,
      "text": "Ectomorph ako kaya hindi ako masyado nagkakalaman?"
    },
    {
      "startSeconds": 76.26,
      "endSeconds": 79.22,
      "text": "Or endomorph ako kaya doomed na akong tumaba?"
    },
    {
      "startSeconds": 79.34,
      "endSeconds": 83.04,
      "text": "You are not trapped in a label made in the 1940s."
    },
    {
      "startSeconds": 83.26,
      "endSeconds": 84.08,
      "text": "Control your nutrition,"
    },
    {
      "startSeconds": 84.18,
      "endSeconds": 87.64,
      "text": "train hard and stop capping your own potential."
    }
  ],

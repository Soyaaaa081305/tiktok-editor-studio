{
  "version": "7.0.0",
  "updated": "2026-10-09",
  "role": "supporting defaults; the three streamlined prompts contain operating instructions",
  "core_prompts": {
    "always_on": "ALWAYS-ON.md",
    "editor": "TIKTOK-EDITOR.md",
    "script_generator": "SCRIPT-GENERATOR.md"
  },
  "modes": [
    "EDIT_AND_EXPORT",
    "PLAN_ONLY"
  ],
  "language": "Taglish",
  "pacing": {
    "zero_dead_air": true,
    "max_pause_seconds": 0.2
  },
  "duration_seconds": {
    "min": 45,
    "max": 60,
    "pad_to_minimum": false,
    "speed_up_dialogue": false
  },
  "research": {
    "selected_study_target": {
      "min": 1,
      "max": 3
    },
    "invent_to_meet_quota": false,
    "primary_search": "PubMed and original publisher/full-text sources",
    "include_challenging_evidence": true
  },
  "canvas": {
    "width": 1080,
    "height": 1920,
    "color_space": "Rec.709 SDR",
    "fps": 60,
    "key_content_working_bounds": {
      "left": 80,
      "right": 1000,
      "top": 120,
      "bottom": 1720
    }
  },
  "visual": {
    "style": "News Daddy 55/45 vertical split with Smartfit Taglish delivery",
    "format": "55/45 vertical split (Top 55% B-roll/proof, 10px gold divider, Bottom 45% presenter)",
    "stacked_upper_height_fraction": 0.55,
    "top_split_height_px": 1056,
    "bottom_split_height_px": 864,
    "divider_px": 10,
    "divider_color": "#FFE600",
    "divider_y_px": 1056,
    "default_transition": "direct cut",
    "default_font": "Inter, Arial Black, sans-serif",
    "body_weight": 700,
    "headline_weight": 900,
    "accent_color": "#FFE600"
  },
  "captions": {
    "format": "Remotion Caption-compatible JSON with word-level spring timings",
    "default_case": "sentence case",
    "font_size_px": {
      "min": 48,
      "max": 56
    },
    "words_per_phrase_starting_range": {
      "min": 3,
      "max": 6
    },
    "max_lines": 2,
    "default_center_y_px": 1380,
    "highlight_color": "#FFE600",
    "word_spring": true,
    "starting_outline_px": 3
  },
  "cover": {
    "clear_hold_seconds": 0.1,
    "frames_formula": "max(1, round(0.1 * outputFps))",
    "genuine_image_required": true
  },
  "audio": {
    "dialogue": "original voice at natural pace; zero dead air (>0.2s cuts)",
    "sfx_enabled": true,
    "sfx_policy": "meaningful events on visual cuts and evidence reveals; -14 dB relative to dialogue",
    "music": {
      "enabled": false,
      "enable_only_on_explicit_user_request": true
    },
    "integrated_lufs_target": {
      "min": -16,
      "max": -14
    },
    "true_peak_ceiling_dbtp": -1.5
  },
  "trademark": {
    "account": "noda.lifts",
    "spoken_line": "Like and follow for more science-based lifting advice. God bless!",
    "default": "include in clean-read script, record and count toward duration"
  },
  "exports": {
    "vertical": {
      "width": 1080,
      "height": 1920,
      "fps": 60,
      "container": "MP4",
      "video": "H.264, yuv420p, Rec.709",
      "audio": "AAC, 48 kHz"
    }
  }
}
